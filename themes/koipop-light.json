	"semanticHighlighting": true,
	"semanticTokenColors": {
		"string": "#faad0c",
		"regexp": "#faad0c",
		"number": "#e53af5",
		"class": "#baa30b",
		"decorator": "#89e70b",
		"function": "#89e70b",
		"method": "#89e70b",
		"type": "#10e2d4",
		"interface": "#10e2d4",
		"typeParameter": "#10e2d4",
		"parameter": "#191b1f",
		"property": "#191b1f",
		"variable": "#191b1f"
	},
	"tokenColors": [
		{
			"name": "Orange: strings e.g. `'abc'`",
			"scope": ["string", "markup.inline.raw"],
			"settings": {
				"foreground": "#faad0c"
			}
		},
		{
			"name": "Green: functions e.g. `myFunc()`",
			"scope": ["entity.name.function", "support.function", "meta.function-call.generic.python"],
			"settings": {
				"foreground": "#89e70b"
			}
		},
		{
			"name": "Yellow: classes e.g. `new MyClass()`",
			"scope": [
				"entity.name.type.class",
				"entity.other.inherited-class",
				"variable.language.this",
				"variable.language.super",
				"markup.bold",
				"markup.italic",
				"support.class",
				"variable.language.self",
				"variable.language.special.self",
				"variable.parameter.function.language.special.self"
			],
			"settings": {
				"foreground": "#baa30b"
			}
		},
		{
			"name": "Purple: numbers e.g `123`, constants e.g. `null`",
			"scope": ["constant.numeric", "constant.language", "support.constant"],
			"settings": {
				"foreground": "#e53af5"
			}
		},
		{
			"name": "Pink: keywords e.g. `export` or `readonly` or `private`, declarations e.g. `const` and `function`",
			"scope": [
				"keyword.control",
				"keyword.operator.new",
				"keyword.operator.expression",
				"storage.modifier",
				"storage.type",
				"entity.other.attribute-name.pseudo-class",
				"entity.name.tag",
				"keyword.operator.logical.python",
				"keyword.other.namespace.php",
				"keyword.other.use.php",
				"keyword.other.new.php",
				"keyword.operator.as.php",
				"keyword.package.go",
				"keyword.const.go",
				"keyword.var.go",
				"keyword.type.go",
				"keyword.struct.go",
				"keyword.interface.go",
				"keyword.map.go",
				"keyword.channel.go",
				"keyword.function.go",
				"keyword.other.rust",
				"keyword.other.fn.rust",
				"keyword.other.special-method.ruby",
				"source.sql keyword",
				"keyword.other.important.css"
			],
			"settings": {
				"foreground": "#f43789"
			}
		},
		{
			"name": "Cyan: primitive types e.g. `string`, complex types e.g. `MyType`",
			"scope": [
				"support.type.builtin",
				"support.type.primitive",
				"entity.name.type",
				"punctuation.definition.heading",
				"string.other.link.title",
				"entity.other.attribute-name",
				"keyword.other.type.php",
				"support.type.python",
				"support.other.namespace",
				"entity.name.namespace",
				"storage.type.string.go",
				"storage.type.numeric.go",
				"storage.type.boolean.go",
				"storage.type.error.go",
				"storage.type.byte.go",
				"storage.type.rune.go",
				"storage.type.uintptr.go",
				"storage.type.sql"
			],
			"settings": {
				"foreground": "#10e2d4"
			}
		},
		{
			"name": "Dark cyan: markdown links",
			"scope": ["markup.underline.link"],
			"settings": {
				"foreground": "#10e2d488"
			}
		},
		{
			"name": "Blue: info",
			"scope": [],
			"settings": {
				"foreground": "#1964cf"
			}
		},
		{
			"name": "Red: errors",
			"scope": ["invalid"],
			"settings": {
				"foreground": "#d41f1f"
			}
		},
		{
			"name": "White: variables, object keys, markup, plain identifiers in languages that leave them unscoped (Python, Ruby, Rust)",
			"scope": [
				"variable",
				"support.type.property-name",
				"entity.name.label",
				"meta.object-literal.key string",
				"markup",
				"markup string",
				"meta.paragraph",
				"constant.other.color",
				"text.html.derivative",
				"source.python",
				"source.ruby",
				"source.rust",
				"constant.other.php",
				"constant.other.class.php",
				"entity.name.tag.yaml",
				"constant.other.table-name.sql",
				"constant.other.database-name.sql"
			],
			"settings": {
				"foreground": "#191b1f"
			}
		},
		{
			"name": "Grey: punctuation, operators, comments and docstrings",
			"scope": [
				"comment",
				"punctuation",
				"storage.type.function.arrow",
				"meta.brace",
				"keyword.operator",
				"string.quoted.docstring",
				"constant.character.format.placeholder.other.python",
				"keyword.other.alias.sql",
				"keyword.other.order.sql",
				"keyword.other.DDL.create.II.sql"
			],
			"settings": {
				"foreground": "#454b54"
			}
		},
		{
			"name": "Bold: bold markup",
			"scope": ["markup.bold"],
			"settings": {
				"fontStyle": "bold"
			}
		},
		{
			"name": "Italic: bold markup, type annotations e.g. `x: string`",
			"scope": ["meta.type.annotation", "meta.return.type", "markup.italic"],
			"settings": {
				"fontStyle": "italic"
			}
		},
		{
			"name": "Underline: URLs",
			"scope": ["*url*", "*link*", "*uri*"],
			"settings": {
				"fontStyle": "underline"
			}
		}
	]
}
